  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "@biomejs/biome": "^1.0.0",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
